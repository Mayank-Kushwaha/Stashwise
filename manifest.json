{
  "manifest_version": 3,
  "name": "AI Bookmark Vault",
  "version": "1.0.0",
  "description": "One-click save. AI titles, descriptions and topics, search, and Ask AI over your saved sites. Synced through your private GitHub Gist.",
  "permissions": ["activeTab", "scripting", "storage", "alarms", "contextMenus"],
  "host_permissions": [
    "https://api.github.com/*",
    "https://gist.githubusercontent.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": { "service_worker": "background.js", "scripts": ["background.js"], "type": "module" },
  "action": { "default_title": "Save to Vault (Alt+Shift+S)" },
  "commands": {
    "save-page": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "Save this page to the Vault" },
    "open-vault": { "suggested_key": { "default": "Alt+Shift+V" }, "description": "Open the Vault" }
  },
  "options_ui": { "page": "app/index.html", "open_in_tab": true },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "browser_specific_settings": { "gecko": { "id": "ai-bookmark-vault@mayank.local", "strict_min_version": "121.0" } }
}
